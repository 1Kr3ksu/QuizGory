<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="QuizGóry.MainPage"
    BackgroundColor="#2E7CB8">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20">

            <Image
                x:Name="ObrazPytania"
                HeightRequest="300"
                Aspect="AspectFit"
                HorizontalOptions="Center" />

            <Label
                x:Name="TrescPytania"
                TextColor="White"
                FontSize="24"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <RadioButton
                x:Name="OdpowiedzPierwsza"
                GroupName="odpowiedzi"
                TextColor="White"
                FontSize="18"
                HorizontalOptions="Start" />

            <RadioButton
                x:Name="OdpowiedzDruga"
                GroupName="odpowiedzi"
                TextColor="White"
                FontSize="18"
                HorizontalOptions="Start" />

            <RadioButton
                x:Name="OdpowiedzTrzecia"
                GroupName="odpowiedzi"
                TextColor="White"
                FontSize="18"
                HorizontalOptions="Start" />

            <Button
                Text="DALEJ"
                TextColor="White"
                FontSize="18"
                BackgroundColor="DarkViolet"
                HorizontalOptions="Center"
                Clicked="OnNextClicked" />

            <Label
                x:Name="PunktyLabel"
                Text="Punkty: 0"
                TextColor="White"
                FontSize="20"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>