<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuizGóry.MainPage"
             BackgroundColor="#2E7CB8"
             >

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="zad1.jpg"
                HeightRequest="300"
                Aspect="AspectFit"
                HorizontalOptions="Center"
        />

            <Label
                Text="Które to schronisko?"
                FontSize="24"
                TextColor="White"
                HorizontalOptions="Center"
                />
            <RadioButton
                Content="Na Rysiance."
                FontSize="18"
                TextColor="White"
                HorizontalOptions="Start"
                GroupName="schronisko" />
            <RadioButton   
                Content="Na Wielkiej Raczy."
                FontSize="18"   
                TextColor="White"
                HorizontalOptions="Start"
                GroupName="schronisko" />
            <RadioButton
                Content="Na Wielkiej Rycerzowej."
                FontSize="18" 
                TextColor="White"
                HorizontalOptions="Start"
                GroupName="schronisko" />
            <Button 
                Text="DALEJ"
                TextColor="White"
                FontSize="18" 
                BackgroundColor="DarkViolet"
                HorizontalOptions="Center"
                 />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
